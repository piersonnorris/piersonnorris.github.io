# This folder doubles as an Obsidian vault for daily working notes/context.
# Those notes should stay local and never end up in the public site repo,
# so everything is ignored by default and only the actual site files are
# explicitly allowed back in below. Add new site files/folders here as
# the site grows.

*

!/.gitignore
!/.nojekyll
!/README.md
!/HANDOFF_PROMPT.md
!/index.html
!/llms.txt
!/robots.txt
!/assets/
!/assets/**
!/docs/
!/docs/**
!/experience/
!/experience/**
!/notes/
!/notes/index.html
!/notes/README.md
!/tools/
!/tools/tracker/
!/tools/tracker/README.md
!/tools/tracker/index.html
!/tools/tracker/index.template.html
!/tools/tracker/build.js
!/tools/tracker/calendar.test.js
!/tools/tracker/taskboard.test.js
!/.github/
!/.github/workflows/
!/.github/workflows/refresh-tracker.yml
/docs/STOCK_UPDATE_PROMPT.md
